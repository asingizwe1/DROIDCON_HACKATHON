# ---- Typesense (server-side only, NEVER ship these to Flutter) ----
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_ADMIN_KEY=your_admin_api_key_here

# Search-only parent key. Must have ONLY documents:search on the inspections
# collection. Scoped keys are derived from this one.
TYPESENSE_SEARCH_KEY=your_search_only_key_here

# Collection name
TYPESENSE_COLLECTION=inspections

# How long a generated scoped key stays valid (seconds). Default 24h.
SEARCH_KEY_TTL_SECONDS=86400

# ---- API ----
PORT=8080
